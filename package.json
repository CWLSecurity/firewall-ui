{
  "name": "firewall-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run src/modules/app-shell/globalSiteStatus.smoke.test.ts src/modules/app-shell/actionsQueue.test.ts src/modules/app-shell/helpers.test.ts src/modules/app-shell/useGlobalSiteStatus.test.ts src/modules/wallet/useFirewallWalletState.test.ts src/modules/vault/model.test.ts src/contracts/createWalletPoliciesFlow.test.ts src/contracts/policies.test.ts src/lib/wagmi/config.test.ts",
    "smoke": "npm run test:smoke && npm run build",
    "security:static": "./scripts/security-static-check.sh",
    "bot:server": "node server/queue-bot-server.mjs",
    "bot:server:watch": "node --watch server/queue-bot-server.mjs",
    "bot:deploy:remote": "bash ./scripts/deploy-bot-remote.sh",
    "integrity:check": "./scripts/integrity.sh check",
    "integrity:update": "./scripts/integrity.sh update"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.46.3",
    "wagmi": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
